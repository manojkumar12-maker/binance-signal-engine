# Binance USDT-M Futures Trading Bot - environment configuration (placeholders only)
# LIVE TRADING IS DISABLED BY DEFAULT. Do not enable without authorization.

# Mode
TRADING_MODE=demo                # demo | testnet | live
BROKER_ENABLED=false
AUTO_TRADE=false
LIVE_TRADING_ENABLED=false
USE_TESTNET=true

# Binance credentials (never commit real values)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Account
SIMULATED_STARTING_BALANCE=5.0
MAX_SIMULTANEOUS_POSITIONS=1
MAX_NEW_ENTRIES_PER_DAY=1
MAX_DAILY_LOSS_USDT=0.10
MAX_PLANNED_LOSS_PER_TRADE=0.05
MAX_LEVERAGE=2
CROSS_MARGIN=false

# Fees (conservative estimates if unavailable)
ESTIMATED_MAKER_FEE=0.0002
ESTIMATED_TAKER_FEE=0.0005
ESTIMATED_SLIPPAGE=0.0005
MIN_REWARD_TO_RISK=2.0

# Strategy
SYMBOL=BTCUSDT
TIMEFRAME=15m
SIGNAL_COOLDOWN_SECONDS=3600

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database
DATABASE_URL=sqlite:///data/bot.db
