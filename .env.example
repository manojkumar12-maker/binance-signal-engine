# Binance USDT-M Futures Trading Bot - environment configuration (placeholders only)
# PAPER MODE ONLY. LIVE TRADING IS DISABLED BY DEFAULT.

# Mode: paper | demo (alias for paper) | testnet | live (never enable via dashboard)
TRADING_MODE=paper
BROKER_ENABLED=false
AUTO_TRADE=false
LIVE_TRADING_ENABLED=false
USE_TESTNET=true

# Binance credentials (not required for PAPER mode; public market data only)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Account
SIMULATED_STARTING_BALANCE=30.0
MAX_SIMULTANEOUS_POSITIONS=1
MAX_NEW_ENTRIES_PER_DAY=1
MAX_DAILY_LOSS_USDT=0.10
MAX_PLANNED_LOSS_PER_TRADE=0.05
MAX_LEVERAGE=1
CROSS_MARGIN=false

# Risk (percent-based)
RISK_PER_TRADE_PCT=0.005
MAX_DAILY_LOSS_PCT=0.01

# Fees (conservative estimates)
ESTIMATED_MAKER_FEE=0.0002
ESTIMATED_TAKER_FEE=0.0005
ESTIMATED_SLIPPAGE=0.0005
MIN_REWARD_TO_RISK=2.0

# Strategy
SYMBOL=BTCUSDT
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT
TIMEFRAME=15m
SIGNAL_COOLDOWN_SECONDS=3600
SCAN_INTERVAL_SECONDS=60
SCAN_TOP_N=30

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
RUN_WORKER=true

# Database (use a persistent path/volume in production)
DATABASE_URL=sqlite:///data/bot.db

# Admin (set securely in production; no default password)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TOKEN=
SESSION_TTL_SECONDS=3600
COOKIE_SECURE=false

# Optional AI (disabled by default)
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT=10