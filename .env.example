# Environment Variables for Binance Signal Engine

# Telegram (Alerts)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Binance (API) - optional, only for authenticated endpoints
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET_KEY=your-binance-secret-key

# Server
PORT=8080
HOST=0.0.0.0

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Signal Engine Settings
MIN_CONFIDENCE=75
SNIPER_MODE=true
MAX_SIGNALS_PER_DAY=10

# Frontend
# Set this in GitHub repo Variables for GitHub Pages build
REACT_APP_API_URL=https://your-app.fly.dev/api
